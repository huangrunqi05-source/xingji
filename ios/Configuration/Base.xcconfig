XINGJI_BUNDLE_ID = com.example.Xingji
XINGJI_CLOUD_CONTAINER = iCloud.$(XINGJI_BUNDLE_ID)
XINGJI_CLOUD_ENABLED = NO
AMAP_API_KEY =
DEVELOPMENT_TEAM =
#include? "Local.xcconfig"
PRODUCT_BUNDLE_IDENTIFIER = $(XINGJI_BUNDLE_ID)
IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 5.0
TARGETED_DEVICE_FAMILY = 1
INFOPLIST_FILE = App/Resources/Info.plist
CODE_SIGN_ENTITLEMENTS = App/Resources/Xingji.entitlements
CODE_SIGN_STYLE = Automatic
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ENABLE_USER_SCRIPT_SANDBOXING = NO
SWIFT_EMIT_LOC_STRINGS = YES
